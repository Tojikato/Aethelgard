rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      allow read: if owner();
      allow create: if owner()
        && request.resource.data.keys().hasOnly(['level','sanity','gold','renown','class','name'])
        && request.resource.data.level == 1 && request.resource.data.sanity == 100
        && request.resource.data.gold == 0 && request.resource.data.renown == 0
        && request.resource.data.class == 'Wandering Soul' && request.resource.data.name == '';
      allow update: if owner()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name','gold','sanity','focusStartTime'])
        && (
          // name must remain a valid string 1–32 chars (or unchanged)
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name'])
           || (request.resource.data.name is string
               && request.resource.data.name.size() > 0
               && request.resource.data.name.size() <= 32))
        )
        && (
          // gold must be a non-negative number (or unchanged)
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['gold'])
           || (request.resource.data.gold is number && request.resource.data.gold >= 0))
        )
        && (
          // sanity must be 0–100 (or unchanged)
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['sanity'])
           || (request.resource.data.sanity is number
               && request.resource.data.sanity >= 0
               && request.resource.data.sanity <= 100))
        );

      // ── Vault of Echoes — Inventory sub-collection ──────────────
      match /inventory/{itemId} {
        allow read: if owner();
        allow create: if owner()
          && request.resource.data.keys().hasOnly(['itemId','quantity'])
          && request.resource.data.itemId is string
          && request.resource.data.quantity is number
          && request.resource.data.quantity >= 1;
        allow update: if owner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity'])
          && request.resource.data.quantity is number
          && request.resource.data.quantity >= 0;
        allow delete: if owner();
      }
    }
  }
}
